### Admin Organization Management (aligned to OrganizationResource)
### Resource: src/main/kotlin/com/docuhyphen/app/api/resource/OrganizationResource.kt

@host = {{host}}
@Authorization = {{Authorization}}
@organizationId = {{organizationId}}
@linkedOrganizationId = {{organizationId}}
@requestId = {{$uuid}}
@stepUpAuth = false
@dualApprovalId =

### Update organization (requires step-up auth)
PUT {{host}}/organizations/{{organizationId}}
Authorization: Bearer {{Authorization}}
Content-Type: application/json
X-Step-Up-Auth: {{stepUpAuth}}
X-Dual-Approval-Id: {{dualApprovalId}}
X-Request-Id: {{requestId}}

{
  "name": "Updated Organization Name",
  "registrationNumber": "REG-123456"
}

### Update organization settings (requires step-up auth)
PUT {{host}}/organizations/{{organizationId}}/settings
Authorization: Bearer {{Authorization}}
Content-Type: application/json
X-Step-Up-Auth: {{stepUpAuth}}
X-Dual-Approval-Id: {{dualApprovalId}}
X-Request-Id: {{requestId}}

{
  "allowShareWithoutPairing": true,
  "allowProfileUpdate": true,
  "allowEmailUpdate": true
}

### Get linked organizations
GET {{host}}/organizations/linked/
Authorization: Bearer {{Authorization}}
Content-Type: application/json

### Get linked organization app users (directory lookup guard uses X-Request-Id)
GET {{host}}/organizations/linked/{{linkedOrganizationId}}/app-users
Authorization: Bearer {{Authorization}}
Content-Type: application/json
X-Request-Id: {{requestId}}

### Get linked organization groups (directory lookup guard uses X-Request-Id)
GET {{host}}/organizations/linked/{{linkedOrganizationId}}/groups
Authorization: Bearer {{Authorization}}
Content-Type: application/json
X-Request-Id: {{requestId}}

