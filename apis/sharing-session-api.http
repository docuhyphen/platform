### Initiate sharing session
POST http://localhost:8080/sharing-sessions
Authorization: Bearer {{Authorization}}
Content-Type: application/json

{
  "initialShareMessage": "Please review the attached documents.",
  "description": "Document sharing session for project review.",
  "recipientEmail": "recipient12adasd@example.com",
  "sessionName": "Project Review Session",
  "sessionDocuments": [
    {
      "title": "Project Plan",
      "type": "PDF"
    },
    {
      "title": "Budget Report",
      "type": "WORD"
    }
  ],
  "requestRecipientSignIn": true,
  "allowDocumentAddition": true,
  "allowDocumentDeletion": false,
  "allowDocumentDownload": true,
  "allowDocumentUpdate": true,
  "allowDocumentUpload": true
}

### Get logged in user sharing sessions
GET http://localhost:8080/sharing-sessions
Authorization: Bearer {{Authorization}}
Content-Type: application/json

### Get Sharing Session by id
GET http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588a0acb9e6
Authorization: Bearer {{Authorization}}
Content-Type: application/json

### Update Sharing Session
PUT http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588a0acb9e
Authorization: Bearer {{Authorization}}
Content-Type: application/json

{
  "sessionName": "Insurance application review2",
  "status": "ACCEPTED_STARTED",
  "initialShareMessage": "Please review the attached documents.",
  "description": "Document sharing session for project review.",
  "allowDocumentAddition": true,
  "allowDocumentDeletion": false,
  "allowDocumentDownload": true,
  "allowDocumentUpdate": true,
  "allowDocumentUpload": true
}

### Add sharing session document
POST http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588aacb9e6/documents
Authorization: Bearer {{Authorization}}
Content-Type: application/json

{
  "title": "Project Plansy",
  "restrictedType": "PDF"
}

### Get sharing session document
GET http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588a0acb9e6/documents/149da4af-6e5e-41af-a9a1-7f40fbc6e341
Authorization: Bearer {{Authorization}}
Content-Type: application/json

### Update sharing session document
PUT http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588a0acb9e6/documents/b4cbefb4-3d94-4864-93b1-2f554b959cca
Authorization: Bearer {{Authorization}}
Content-Type: application/json

{
  "title": "asdasdasd",
  "restrictedType": "WORD"
}

### Delete sharing session document
DELETE http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588a0acb9e6/documents/f48bf983-cc03-4c2f-b389-c748c664953c
Authorization: Bearer {{Authorization}}

### Get sharing session document audit logs
GET http://localhost:8080/sharing-sessions/b4b502a5-86d0-4e59-ba05-f588a0acb9e6/documents/f48bf983-cc03-4c2f-b389-c748c664953c/audit
Authorization: Bearer {{Authorization}}
