# Ignore everything by default
**

# Allow Quarkus build output only (built by Maven before Docker build)
!target/
!target/quarkus-app/
!target/quarkus-app/**

# Explicitly exclude build/dev artefacts that should never enter the image
target/quarkus-app/lib/deployment/
src/
infra/
website/
web-app/
.idea/
*.iml
.DS_Store
Thumbs.db
*.md

# Runtime data mounted as a single volume in local development
local-development-resources/
