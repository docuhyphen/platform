QUARKUS_PROFILE=staging;
LOG_JSON=true;
LOG_LEVEL=DEBUG;
LOG_FILE_ENABLE=false;
HIBERNATE_SHOW_SQL=false;
DB_USERNAME=docuhyphen_staging_user;
DB_PASSWORD=replace-with-staging-secret;
JWT_SECRET=replace-with-staging-32-char-secret;
AWS_REGION=af-south-1;
JWT_SECRET_ID=docuhyphen/jwt/staging-signing-key;
APP_SECRETS_ORG_IDP_REGION=af-south-1;
APP_SECRETS_ORG_IDP_PREFIX=docuhyphen/org/staging;
APP_SECRETS_ROTATION_ENABLED=true;
APP_SECRETS_ROTATION_INTERVAL_DAYS=60;
APP_SECRETS_ROTATION_OVERLAP_HOURS=24;
APP_SECRETS_ROTATION_ALLOW_PREVIOUS_DURING_OVERLAP=true;
APP_SECRETS_ROTATION_ROLLBACK_ENABLED=true;
APP_SECRETS_ROTATION_ROLLBACK_REQUIRE_MONITOR_PHASE=true;
APP_SECRETS_ROTATION_RUNTIME_ALLOWED_PHASES=MONITOR,ACTIVATE;
MICROSOFT_CLIENT_ID=staging-microsoft-client-id;
MICROSOFT_CLIENT_SECRET=replace-with-staging-secret;
MICROSOFT_TENANT_ID=common;
MICROSOFT_REDIRECT_URI=https://staging.docuhyphen.com/auth/oauth/MICROSOFT/callback;
GOOGLE_CLIENT_ID=staging-google-client-id.apps.googleusercontent.com;
GOOGLE_CLIENT_SECRET=replace-with-staging-secret;
GOOGLE_REDIRECT_URI=https://staging.docuhyphen.com/auth/oauth/GOOGLE/callback;
APP_OIDC_ALLOWED_CLOCK_SKEW_SECONDS=120;
APP_OIDC_REQUIRE_AZP_WHEN_MULTI_AUD=true;
APP_OIDC_REQUIRED_CLAIMS_GOOGLE=sub,email,iss,aud,exp,iat,nonce;
APP_OIDC_REQUIRED_CLAIMS_MICROSOFT=sub,iss,aud,exp,iat,nonce;
APP_OIDC_VALIDATION_STRICT=true;
APP_AUTH_ACCESS_TOKEN_DEFAULT_MINUTES=15;
APP_AUTH_REFRESH_TOKEN_DEFAULT_DAYS=7;
APP_AUTH_EXCHANGE_MAX_DEFAULT_HOURS=168;
APP_AUTH_ACCESS_TOKEN_MIN_MINUTES=5;
APP_AUTH_ACCESS_TOKEN_MAX_MINUTES=60;
APP_AUTH_REFRESH_TOKEN_MIN_DAYS=1;
APP_AUTH_REFRESH_TOKEN_MAX_DAYS=30;
APP_AUTH_EXCHANGE_MAX_MIN_HOURS=1;
APP_AUTH_EXCHANGE_MAX_MAX_HOURS=720;
APP_AUTH_EXCHANGE_VERSION_ENABLED=true;
APP_AUTH_REFRESH_ROTATION_ENABLED=true;
APP_AUTH_REFRESH_ROTATION_GRACE_SECONDS=60;
APP_AUTH_REFRESH_REUSE_DETECTION_ENABLED=true;
APP_AUTH_REFRESH_STRICT_REUSE_DETECTION=false;
APP_AUTH_CSRF_ENABLED=true;
APP_AUTH_CSRF_REQUIRE_ORIGIN_CHECK=true;
APP_AUTH_OAUTH_STATE_TTL_SECONDS=300;
APP_AUTH_RATE_LIMIT_ENABLED=true;
APP_AUTH_RATE_LIMIT_LOOKUP_PER_MINUTE=120;
APP_AUTH_RATE_LIMIT_DIRECTORY_PER_MINUTE=120;
APP_AUTH_RATE_LIMIT_CALLBACK_PER_MINUTE=120;
APP_AUTH_RATE_LIMIT_REFRESH_PER_MINUTE=60;
APP_AUTH_RATE_LIMIT_LOGOUT_PER_MINUTE=60;
APP_AUTH_RATE_LIMIT_AUTHORIZE_PER_MINUTE=120;
APP_AUTH_RATE_LIMIT_SIGN_IN_INITIATE_PER_MINUTE=60;
APP_AUTH_RATE_LIMIT_SIGN_IN_COMPLETION_PER_MINUTE=60;
APP_AUTH_APPLICATION_DEFAULT_SCOPES=application:api;
APP_AUTH_APPLICATION_REQUIRED_SCOPE=application:api;
APP_AUTH_APPLICATION_INTEGRATION_SCOPE=application:integration;
APP_AUTH_APPLICATION_SERVICE_SCOPE=application:service;
APP_AUTH_APPLICATION_ALLOWED_ENDPOINT_PREFIXES=/auth/application/integration,/auth/application/service;
APP_AUDIT_IMMUTABLE_ENABLED=true;
APP_AUDIT_WORM_ENABLED=true;
APP_AUDIT_WORM_DIRECTORY=/var/log/docuhyphen/audit-worm;
APP_AUTH_DPOP_ENABLED=false;
APP_SCIM_BEARER_TOKEN=replace-with-staging-scim-token-or-empty;
APP_IDP_DIRECTORY_LOOKUP_MAX_RESULTS=100;
APP_IDP_DIRECTORY_LOOKUP_MIN_QUERY_LENGTH=3;
APP_IDP_JIT_ENABLED=true;
APP_IDP_JIT_ROLE_FLOOR=ORG_MEMBER;
APP_IDP_DIRECTORY_ON_DEMAND_ENABLED=true;
APP_IDP_DIRECTORY_BULK_IMPORT_ENABLED=false;
APP_ORG_TIER_ENFORCEMENT_ENABLED=true;
REDIS_HOSTS=redis://localhost:6379;

